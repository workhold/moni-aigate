# Generate private values using: go run ./cmd/moni-aigate init-env
DATABASE_URL=postgres://moni_app:REPLACE@127.0.0.1:5432/moni?sslmode=disable
PROJECTION_DATABASE_URL=postgres://moni_projection:REPLACE@127.0.0.1:5432/moni?sslmode=disable
MIGRATION_DATABASE_URL=postgres://moni_owner:REPLACE@127.0.0.1:5432/moni?sslmode=disable
MASTER_KEY_ID=primary
MASTER_KEY=BASE64_32_BYTES
AUTH_SECRET=BASE64_32_BYTES
PUBLIC_ORIGIN=https://gateway.example.com
COOKIE_SECURE=true
# Optional by default; true requires platform/admin/finance accounts to enroll.
# Accounts that already enabled MFA still verify it under either setting.
MFA_ENFORCE_PLATFORM=false
# Empty trusts no forwarding headers. Set only actual edge proxy source CIDRs.
# The edge must overwrite X-Real-IP; never use universal networks or public ranges.
TRUSTED_PROXY_CIDRS=
LISTEN_ADDR=127.0.0.1:8080
RECOVERY_MODE=false
# Rotation: retain all referenced versions; MASTER_KEY_ID selects an entry.
# MASTER_KEYS_JSON='{"primary":"BASE64_32_BYTES","next":"BASE64_32_BYTES"}'

# 021 self-service identity; registration and mail are off by default.
AUTH_REGISTRATION_ENABLED=false
AUTH_PASSWORD_RESET_ENABLED=true
MAIL_TRANSPORT=disabled
# Configure SMTP before enabling the self-service identity mail workflow.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=noreply@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS_MODE=starttls

# 022 vouchers: deployment hard ceiling and DB policy both default off.
VOUCHERS_ENABLED=false
OPERATIONS_ALERTS_ENABLED=false
# Payment integration is disabled by default. Only the isolated local sandbox
# accepts paired private application/worker manifests. Live mode is rejected.
PAYMENTS_MODE=off
# PAYMENTS_APP_MANIFEST=/absolute/private/application.json
# PAYMENTS_WORKER_MANIFEST=/absolute/private/worker.json
# Use a separate random 32-byte key per version, canonical raw base64url.
# Retain all versions referenced by issued codes and commerce commands.
# VOUCHER_HMAC_ACTIVE_KEY=v1
# VOUCHER_HMAC_KEYS='{"v1":"RAW_BASE64URL_32_BYTES"}'
